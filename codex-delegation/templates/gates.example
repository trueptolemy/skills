# Gate list for run-gates.sh: `name | shell command`, run inside the worktree.
# WT is exported, TMPDIR and PYTEST_DEBUG_TEMPROOT point to the worktree's own
# .tmp/, and GATE_ENV is applied. Do not hard-code /tmp in a gate (for example
# pytest --basetemp=/tmp/...): parallel runs would share it. Put the harness
# check first: a gate run that tests another checkout is worse than no gate run.

# --- Generic Python project with an editable install -----------------------
import-path   | python -c 'import mypkg, os, sys; p = os.path.realpath(mypkg.__file__); sys.exit(0 if p.startswith(os.environ["WT"] + "/") else "imported outside worktree: " + p)'
ruff          | python -m ruff check src tests
format        | python -m ruff format --check src tests
mypy          | python -m mypy src/mypkg
pytest        | python -m pytest -q

# --- Generated output must be committed (example: a TypeScript bridge) -----
# node-build  | cd bridge && npm run build && git diff --quiet -- lib

# --- autoperf, as used for the 2026-10 Analysis-loop work ------------------
# import-path   | /path/.venv/bin/python -c 'import autoperf, os, sys; p = autoperf.__file__; sys.exit(0 if p.startswith(os.environ["WT"] + "/") else p)'
# npm-typecheck | cd src/autoperf/agent/pi && npm run typecheck
# npm-build     | cd src/autoperf/agent/pi && npm run build && git diff --quiet -- lib
# repo-paths    | /path/.venv/bin/python -m autoperf.repository_paths
# ruff-check    | /path/.venv/bin/python -m ruff check src tests
# ruff-format   | /path/.venv/bin/python -m ruff format --check src tests
# mypy          | /path/.venv/bin/python -m mypy src/autoperf
# pytest        | /path/.venv/bin/python -m coverage run -m pytest
# coverage      | /path/.venv/bin/python -m coverage report -m --fail-under=100
# pylint-src    | /path/.venv/bin/python -m pylint src/autoperf
# pylint-tests  | /path/.venv/bin/python -m pylint tests --load-plugins=autoperf.pylint_checkers,autoperf.pylint_test_config
